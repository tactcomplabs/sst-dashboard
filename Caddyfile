sstdashboard.com {
    reverse_proxy dashboard:3000 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
    }

    header {
        -Server
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    encode gzip zstd

    log {
        output stdout
    }
}
